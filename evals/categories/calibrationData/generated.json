 "Kitchen fitting backlog, growing base orders": {
  "name": "Kitchen fitting backlog, growing base orders",
  "scenario": "kitchenFitters",
  "kind": "structure",
  "series": "job backlog",
  "changes": {
   "set": {
    "base orders": {
     "equation": "10 * EXP(base_orders_growth_rate * (TIME - 0))"
    }
   },
   "add": [
    {
     "name": "base orders growth rate",
     "type": "variable",
     "equation": "0.008887",
     "units": "1/week"
    }
   ]
  },
  "mechanism": "\"base orders\" keeps growing over time instead of staying steady.",
  "distractors": [
   "\"base orders\" rises and falls with the seasons, again and again.",
   "\"job backlog\" drains away on its own over time, through a loss the model leaves out."
  ],
  "calibrated": [
   "base orders",
   "target lead time",
   "maximum rush",
   "normal error fraction"
  ],
  "distractorModels": [
   {
    "mechanism": "\"base orders\" rises and falls with the seasons, again and again.",
    "strength": "base orders seasonal swing",
    "changes": {
     "set": {
      "base orders": {
       "equation": "10 * (1 + base_orders_seasonal_swing * SIN(2 * 3.14159 * (TIME - 0) / 26))"
      }
     },
     "add": [
      {
       "name": "base orders seasonal swing",
       "type": "variable",
       "equation": "0.3",
       "units": "dimensionless"
      }
     ]
    }
   },
   {
    "mechanism": "\"job backlog\" drains away on its own over time, through a loss the model leaves out.",
    "strength": "job backlog loss fraction",
    "changes": {
     "set": {
      "job backlog": {
       "outflows": [
        "jobs fitted",
        "cancellations",
        "job backlog lost"
       ]
      }
     },
     "add": [
      {
       "name": "job backlog lost",
       "type": "flow",
       "equation": "job_backlog * job_backlog_loss_fraction",
       "units": "jobs/week"
      },
      {
       "name": "job backlog loss fraction",
       "type": "variable",
       "equation": "0.01282",
       "units": "1/week"
      }
     ]
    }
   }
  ]
 },
