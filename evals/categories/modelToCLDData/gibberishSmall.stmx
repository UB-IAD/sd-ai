				<connector uid="16" angle="33.74" polarity="+">
					<from>quality_of_reveforly</from>
					<to>pablanksill</to>
				</connector>
				<connector uid="17" angle="337.50" polarity="+">
					<from>memostorer</from>
					<to>hoza</to>
