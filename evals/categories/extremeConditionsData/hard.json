{
 "Regional distributor inventory (hard)": {
  "name": "Regional distributor inventory (hard)",
  "scenario": "distributor",
  "description": "the regional distributor inventory",
  "added": [
   {
    "variable": "shipments",
    "equation": "MIN(demand, inventory / minimum_shipments_time)",
    "constant": {
     "name": "minimum shipments time",
     "type": "variable",
     "equation": "0.25",
     "units": "weeks"
    }
   }
  ],
  "plants": [
   {
    "id": "orders loses the MAX that limits it to 0",
    "kind": "guardRemoved",
    "variable": "orders",
    "equation": "(expected_demand + (desired_inventory - inventory) / adjustment_time + supply_line_weight * (desired_supply_line - supply_line) / adjustment_time)",
    "trigger": {
     "base demand": "0"
    },
    "failure": "with \"base demand\" at 0, \"orders\" loses the MAX that limits it to 0, and the model goes impossible: stock \"inventory\" went negative (-111.4)"
   },
   {
    "id": "shipments keeps flowing after \"inventory\" runs out",
    "kind": "drainUnguarded",
    "variable": "shipments",
    "equation": "demand",
    "trigger": {
     "coverage": "0"
    },
    "failure": "with \"coverage\" at 0, \"shipments\" keeps flowing after \"inventory\" runs out, and the model goes impossible: stock \"inventory\" went negative (-176.3)"
   }
  ]
 },
 "Kitchen fitting backlog (hard)": {
  "name": "Kitchen fitting backlog (hard)",
  "scenario": "kitchenFitters",
  "description": "the kitchen fitting backlog",
  "added": [
   {
    "variable": "schedule pressure",
    "equation": "desired_fitting / MAX(capacity, smallest_capacity)",
    "constant": {
     "name": "smallest capacity",
     "type": "variable",
     "equation": "0.001",
     "units": "jobs/week"
    }
   }
  ],
  "plants": [
   {
    "id": "schedule pressure divides by \"capacity\" with nothing to keep it off zero",
    "kind": "divisionUnguarded",
    "variable": "schedule pressure",
    "equation": "desired_fitting / capacity",
    "trigger": {
     "fitting crews": "0"
    },
    "failure": "with \"fitting crews\" at 0, \"schedule pressure\" divides by \"capacity\" with nothing to keep it off zero, and the run fails"
   }
  ]
 },
 "Regional specialty mushroom growers (hard)": {
  "name": "Regional specialty mushroom growers (hard)",
  "scenario": "mushroomGrowers",
  "description": "the regional specialty mushroom growers",
  "added": [
   {
    "variable": "price",
    "equation": "reference_price * (reference_demand / MAX(production, smallest_production)) ^ price_sensitivity",
