     "type": "variable",
     "equation": "0.001",
     "units": "kg/month"
    }
   }
  ],
  "plants": [
   {
    "id": "price divides by \"production\" with nothing to keep it off zero",
    "kind": "divisionUnguarded",
    "variable": "price",
    "equation": "reference_price * (reference_demand / production) ^ price_sensitivity",
    "trigger": {
     "growing rooms": "0"
    },
    "failure": "with \"growing rooms\" at 0, \"price\" divides by \"production\" with nothing to keep it off zero, and the run fails"
   }
  ]
 },
